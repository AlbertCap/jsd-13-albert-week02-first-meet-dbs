    {
      "id": "ffI-gJcCr6XwApt4-uKYA",
      "type": "text",
      "x": 3179.0254206337568,
      "y": 190.1169313189157,
      "width": 504.2370254037937,
      "height": 262.387843022159,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
