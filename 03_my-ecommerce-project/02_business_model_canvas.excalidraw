      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aL",
      "roundness": null,
      "seed": 417109210,
      "version": 928,
      "versionNonce": 1390380038,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783568906509,
      "link": null,
      "locked": false,
      "text": "-พ่อแม่ผู้ปกครองที่มีลูกวัย 6–12 ปี\nอยากปูพื้นฐานการเงินให้ลูก\n-ครอบครัวที่ชอบทำกิจกรรมร่วมกัน\n(เล่นบอร์ดเกม/อ่านนิทานกับลูก)\n-ครูอนุบาล–ประถม\nที่หาสื่อการสอนเรื่องการเงิน  ",
      "fontSize": 32.393560866933214,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-พ่อแม่ผู้ปกครองที่มีลูกวัย 6–12 ปี อยากปูพื้นฐานการเงินให้ลูก\n-ครอบครัวที่ชอบทำกิจกรรมร่วมกัน (เล่นบอร์ดเกม/อ่านนิทานกับลูก)\n-ครูอนุบาล–ประถม ที่หาสื่อการสอนเรื่องการเงิน  ",
      "autoResize": false,
      "lineHeight": 1.35
    },
    {
      "id": "vAKNjFlMqskwxKf0YrigE",
      "type": "text",
      "x": 1748.8346129542267,
      "y": 156.08695955379605,
      "width": 532.6946268945551,
      "height": 314.3839300598197,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 1328957318,
      "version": 1309,
      "versionNonce": 874460294,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783568875798,
      "link": null,
      "locked": false,
      "text": "-\nเปลี่ยนเรื่องเงินที่คิดในหัวยากให้จับต้องได้ด้ว\nยนิทานและบอร์ดเกม\n-เรียนรู้แบบสนุก เล่นได้ทั้งครอบครัว\nไม่ใช่การท่องจำ\n-มีทั้งสินค้าแบบ Digital Product (ราคาถูก\nเข้าถึงง่าย) \nและของจริง (บอร์ดเกมที่จับต้องได้)",
      "fontSize": 29.10962315368699,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-เปลี่ยนเรื่องเงินที่คิดในหัวยากให้จับต้องได้ด้วยนิทานและบอร์ดเกม\n-เรียนรู้แบบสนุก เล่นได้ทั้งครอบครัว ไม่ใช่การท่องจำ\n-มีทั้งสินค้าแบบ Digital Product (ราคาถูก เข้าถึงง่าย) \nและของจริง (บอร์ดเกมที่จับต้องได้)",
      "autoResize": false,
      "lineHeight": 1.35
    },
